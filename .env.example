# Copy to .env (git-ignored). docker compose reads it automatically.

# Which LLM runs extraction: anthropic (default) | claude-code (dev only) | fake (no LLM)
LLM_PROVIDER=anthropic

# anthropic: an API key from console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# claude-code (development only): a Claude subscription token from `claude setup-token`.
# Not for production — apps may not offer claude.ai login to their users.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_MODEL=sonnet

# fake: deterministic regex extractor; set a delay to make "restart mid-extraction" easy to demo
FAKE_LLM_DELAY_MS=0
